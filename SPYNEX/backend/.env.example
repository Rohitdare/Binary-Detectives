# ==============================================================================
# RingTrace / SPYNEX Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# ==============================================================================

# Google Gemini API Key (Required for Member B Autonomous LLM Agent)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model Settings
GEMINI_MODEL=gemini-3.8-flash
AGENT_MAX_TURNS=8
AGENT_TIMEOUT_S=45
CHAT_MAX_TURNS=4
REPLAY_SCAN_EVERY_N_BATCHES=5
# Legacy timeout setting remains supported for existing local environments.
GEMINI_TIMEOUT_SECONDS=45

# FalkorDB Graph Database Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TIMEOUT_SECONDS=5
FALKORDB_GRAPH=txn
FALKORDB_MEMORY_GRAPH=memory

# Comma-separated explicit browser origins. Add the Vercel origin in Railway.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret for protected demo writes. Required when deployed on Railway.
RINGTRACE_DEMO_KEY=
# Legacy reset key; still accepted when the shared key is unset.
DEMO_KEY=
